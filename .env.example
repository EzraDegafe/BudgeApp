# Optional: copy this file to .env to choose the database.
# Without a .env, the app uses the SQLite file below.

# SQLite file in the project folder. Created automatically when the app starts.
DATABASE_URL=sqlite:///budgeapp.db

# Or PostgreSQL (needs Postgres installed and the database created):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/budgeapp
